                                                                                                    <h4 class="card-title" style="font-size: 14px !important; font-weight: 600;">Loss Items List</h4>
                                                                                                    <div class="table-responsive m-t-0">
                                                                                                        <table id="tblSchoolIncidentLossItems" class="display nowrap table table-hover display table-bordered table-striped dataTable" cellpadding="0" style="width:100%;">
