                                                                                            <span><button id="btnAddLossItems" class="btn btn-outline-info waves-effect waves-light float-right" type="button" style="margin-top:-5px; margin-right:0px;"><span class="btn-label"><i class="mdi mdi-plus"></i></span>Add Loss Item to List</button></span>
                                                                                        </div>
                                                                                        <div class="card-base" style="margin-bottom:-13px;">
                                                                                            <div class="row">
                                                                                                <div class="col-xl-3 col-lg-3 col-md-6" style="margin-top:0px;">
                                                                                                    <div class="row">
                                                                                                        <div class="col" style="margin-top:0px; margin-left:0px;">
                                                                                                            <label>Quantity<span style="vertical-align: super; color:#d7153a;">*</span></label>
                                                                                                            <div class="form-group">
                                                                                                                @Html.TextBoxFor(m => m.Quantity, new { @type = "number", @style = "margin-top:0px;max-width: 360px;", @placeholder = "", @class = "form-control form-control-sm", @onchange = "updateLossDetailsErrorSummery(this);" })

                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                                <div class="col-xl-3 col-lg-3 col-md-6" style="margin-top:0px;">
                                                                                                    <div class="row">
                                                                                                        <div class="col" style="margin-top:0px; margin-left:0px;">
                                                                                                            <label>Current Status<span style="vertical-align: super; color:#d7153a;">*</span></label>
                                                                                                            <div class="form-group">
                                                                                                                @Html.DropDownListFor(x => x.SchoolIncidentLossStatusID, (IEnumerable<SelectListItem>)ViewData["LossStatus"], "Select Loss Status", new RouteValueDictionary(new { @class = "custom-select", @id = "SchoolIncidentLossStatusID" }))

                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                                <div class="col-xl-3 col-lg-3 col-md-6">
                                                                                                    <div class="col">
                                                                                                        <label>Estimated Repair / Replacement Cost<span style="vertical-align: super; color:#d7153a;">*</span></label>
                                                                                                        <div class="form-group">
                                                                                                            <div class="input-group">
                                                                                                                <div class="input-group-prepend">
                                                                                                                    <span class="input-group-text" id="">
                                                                                                                        <span style="margin-left:4px; font-size:13px;">
                                                                                                                            $
                                                                                                                        </span>
                                                                                                                    </span>
                                                                                                                </div>
                                                                                                                @Html.TextBoxFor(m => m.EstRepairCost, new { @style = "max-width: 360px;", @placeholder = "", @class = "form-control form-control-sm", @onchange = "updateLossDetailsErrorSummery(this);", @id = "txtEstRepairCost" })

                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                                <div class="col">
                                                                                                    <label style="margin-left:-16px;">Asset Description<span style="vertical-align: super; color:#d7153a;">*</span></label>
                                                                                                    <div class="form-group">
                                                                                                        @Html.EditorFor(m => m.LossDesc, new { htmlAttributes = new { @style = "margin-left:-16px;", @rows = "5", @placeholder = "", @class = "form-control form-control-sm blue-border-1", @onchange = "updateLossDetailsErrorSummery(this);", @id = "txtLossDesc" } })
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="row" id="lossItemErrorDiv" style="display:none">
                                                                                                <div class="col">
                                                                                                    <div class="validation-summary-errors" style="display:flex; justify-content:center">
