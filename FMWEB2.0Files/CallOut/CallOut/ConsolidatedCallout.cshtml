                                                                                                                    <th>Quantity</th>
                                                                                                                    <th>Status</th>
                                                                                                                    <th>Loss Description</th>
                                                                                                                    <th>Est. Repair Cost</th>
                                                                                                                </tr>
                                                                                                            </thead>
                                                                                                        </table>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <!-- lost item div ends here -->
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>



                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
