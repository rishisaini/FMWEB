@model AssetCare.Model.ViewModels.JobDetails
@using AssetCare.Model.ViewModels
@using AssetCare.Helpers

<div class="p-20">
    <div class="row">
        <div class="col-12">
            @*<div class="row">
            <div class="col-6 float-left">
                <div class="form-group">
                    <label><strong>Total Costing</strong> </label> <label class="blue-theme" style="padding:10px; border-radius:12px;">$ <span id="totalCosting">@Model.Claim.TotalAmount.ToString("0.00")</span></label>
                </div>
            </div>
            <div class="col-6 float-right">
                @{
                    if (!Model.DisableField("costingSection", "addWorkItem"))
                    {
                        <button class="btn btn-outline-info waves-effect waves-light float-right  mr-2" type="button" data-toggle="modal" id="btnAddWorkItems" data-target=".bs-addworkitem-modal-lg"><span class="btn-label"><i class="fa fa-plus-circle"></i></span>Add Work item</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-info waves-effect waves-light float-right  mr-2" type="button" disabled><span class="btn-label"><i class="fa fa-plus-circle"></i></span>Add Work item</button>

                    }
                }

                <a href="#">

                </a>
            </div>
        </div>*@
            <div class="row">
                <div class="col-3 float-left">
                    <div class="form-group">
                        <label ><strong>Total Costing</strong> </label> <label class="blue-theme" style="padding:10px; border-radius:12px;" id="txtClaimTotalAmount">@Model.Claim.TotalAmount.ToString("c")</label>
                    </div>
                </div>
                <div class="col-3 float-left">
                    <div class="form-group">
                        <label><strong>Payment Approved</strong> </label> <label class="blue-theme" style="padding:10px; border-radius:12px;" id="txtTotalApprovedAmount">@Model.Claim.TotalApprovedAmount.ToString("c")</label>
                    </div>
                </div>
                <div class="col-6 float-right">
                    @{
                        if (!Model.DisableField("costingSection", "addWorkItem") && !Model.DetailsTab.SchoolSecuritySubContractor)
                        {
                            <button class="btn btn-outline-info waves-effect waves-light float-right  mr-2" type="button" data-toggle="modal" id="btnAddWorkItems" data-target=".bs-addworkitem-modal-lg"><span class="btn-label"><i class="fa fa-plus-circle"></i></span>Add Work item</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-info waves-effect waves-light float-right  mr-2" type="button" disabled><span class="btn-label"><i class="fa fa-plus-circle"></i></span>Add Work item</button>
                        }
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-xl-12 col-lg-12 ">
                    <div class="card inner-border-1">
                        <div class="card-base">
                            <div class="table-responsive m-t-0" style="margin-top:-14px;">
                                <table id="tblWorkItems" class="table display table-bordered table-striped dataTable">
                                    <thead>
                                        <tr>
                                            <th>Actions</th>
                                            <th>Item No.</th>
                                            <th>Description</th>
                                            <th>Unit</th>
                                            <th>Rate</th>
                                            <th>Quantity</th>
                                            <th>Cost Adj.</th>
                                            <th>Amount</th>
                                            <th>Work Date</th>
                                            <th>Reimbursement Status</th>
                                            <th>Reimbursement Amount</th>
                                            <th>IRCM Comments</th>
                                            <th>Reimbursement Date</th>
                                        </tr>
                                    </thead>
                                    <tbody style="color:#1e88e5;">

                                        @{
                                            int count = 0;
                                            foreach (var workItem in Model.WorkItems)
                                            {

                                                <tr>
                                                    <td>@workItem.ServiceReportLineItemID</td>
                                                    <td>@workItem.ScheduleItemNo</td>
                                                    <td>@workItem.SRLIDescription</td>
                                                    <td class="text-right">@workItem.Unit</td>
                                                    <td class="text-right">
                                                        @{
                                                            if (@workItem.Rate.HasValue)
                                                            {
                                                                @Math.Round(workItem.Rate.Value, 2)
                                                            }
                                                        }
                                                    </td>
                                                    <td class="text-right">@workItem.Quantity</td>
                                                    <td class="text-right">@workItem.CostAdjPercent</td>
                                                    <td class="text-right">
                                                        @{
                                                            if (@workItem.Amount.HasValue)
                                                            {
                                                                @Math.Round(workItem.Amount.Value, 2)
                                                            }
                                                        }
                                                    </td>
                                                    <td class="text-right">
                                                        @{
                                                            if (@workItem.WorkDate.HasValue)
                                                            {
                                                                <text>@workItem.WorkDate.Value.ToString("dd/MM/yyyy")</text>
                                                            }
                                                        }
                                                    </td>
                                                    <td>
                                                        @{
                                                            if (@workItem.ReimbursementStatusID.HasValue)
                                                            {
                                                                <text>@workItem.ReimbursementStatusID.Value</text>
                                                            }
                                                        }
                                                    </td>
                                                    <td>
                                                        @{
                                                            if (@workItem.IRCMReimbursementAmount.HasValue)
                                                            {
                                                                <text>@Math.Round(workItem.IRCMReimbursementAmount.Value, 2)</text>
                                                            }
                                                        }
                                                    </td>
                                                    <td>@workItem.IRCMComments</td>
                                                    <td>
                                                        @{
                                                            if (@workItem.IRCMReimbursementDate.HasValue)
                                                            {
                                                                <text>@workItem.IRCMReimbursementDate.Value.ToString("dd/MM/yyyy")</text>
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                                                count++;

                                                            }
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-base" style="border-top:1px solid #f2f2f2;">
                            <span class="float-right">
                                @{ var isDisabled = Model.DisableField("claimSection", "ClaimFinalized") || Model.WorkItems.Sum(item => item.Amount).GetValueOrDefault() <= 0; }
                                @Html.CheckBoxFor(x => x.Claim.ClaimFinalized, new RouteValueDictionary(new { @class = "filled-in chk-col-light-blue", style = "outline: 1px #5a5a5a;" }).AddIf(isDisabled, "disabled", "disabled"))

                                <label style="font-size:14px;" class="" for="Claim_ClaimFinalized"><strong>Claim</strong></label>
                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;

                                @{
                                    if (Model.Claim.ClaimFinalizedDate.HasValue)
                                    {
                                        <label style="font-size:14px;" class=""><strong>Claim Date: </strong></label><label style="font-size:14px;" class=""> @Model.Claim.ClaimFinalizedDate.Value.ToString("dd/MM/yyyy")</label>
                                    }
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @{
                if (Model.IsInsuranceEventByWO == true || Model.IsInsuranceEvent == true)
                {
                    <div class="row" style="margin-bottom: 25px; ">
                        <div class="col-12">
                            <h3 style="padding-left: 15px;">IRCM Use Only</h3>
                            <div class="card inner-border-1" style="height: 60px">

                                <div class="card-base">

                                    <div class="col-3 float-left">
                                        <div class="form-group">
                                            <label><strong>Total Reimbursement Amount</strong> </label> <label class="blue-theme" style="padding:10px; border-radius:12px;">@Model.Claim.TotalReimbursementAmount.ToString("c")</label>
                                        </div>
                                    </div>
                                    <div class="col-5 float-left" style="padding-top:10px;">

                                        <label style="font-size:14px;"><strong>WO Reimbursement Status: </strong>@Model.Claim.ReimbursementStatusDesc</label>
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                        @{

                                            if (Model.Claim.ReimbursementDate.HasValue)
                                            {
                                                <label style="font-size:14px;"><strong>Status Update Date: </strong></label>
                                                <label style="font-size:14px;" class=""> @Model.Claim.ReimbursementDate.Value.ToString("dd/MM/yyyy")</label>
                                            }
                                        }
                                    </div>

                                    <div class="col-4 float-left" style="padding-top:5px;">
                                        @Html.CheckBoxFor(x => x.Claim.ReimbursementComplete, new RouteValueDictionary(new { @class = "filled-in chk-col-light-blue", style = "outline: 1px #5a5a5a;" }).AddIf(Model.DisableField("claimSection", "ReimbursementComplete"), "disabled", "disabled"))
                                        <label style="font-size:14px;" class="" for="Claim_ReimbursementComplete"><strong>Reimbursement Complete</strong></label>
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                        @{

                                            if (Model.Claim.ReimbursementCompleteDate.HasValue)
                                            {
                                                <label style="font-size:14px;" class=""><strong>Complete Date: </strong></label>
                                                <label style="font-size:14px;" class=""> @Model.Claim.ReimbursementCompleteDate.Value.ToString("dd/MM/yyyy")</label>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            }

        </div>
    </div>
</div>


<div class="modal fade bs-addworkitem-modal-lg" id="schRateModel" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="bs-addworkitem-modal-lg">Add Work Item</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="card" style="border:none;">
                            <div class="card-base" style="margin-bottom:-16px;">
                                <div class="row" style="margin-bottom:16px;" id="costingErrorRow">
                                    <div class="col-sm-12">
                                        <div class="col-sm-12"><span id="costingError" style="color:red;"></span> </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6">
                                        <div class="col-12">
                                            <label>Work Date</label>
                                            <div class="form-group">
                                                <div class="input-group">
                                                    @Html.EditorFor(m => m.WorkItem.WorkDate, new
                                               {
                                                   htmlAttributes = new RouteValueDictionary(new
                                                   {
                                                       @placeholder = "dd/mm/yyyy",
                                                       @class = "form-control form-control-sm datepicker-control",
                                                       @id = "schWorkDate",
                                                       @Value = Model.WorkItem.WorkDate.HasValue ? Model.WorkItem.WorkDate.Value.ToString("dd/MM/yyyy") : "",
                                                   })
                                               })

                                                    <div class="input-group-append datepicker-control-sibling" style="height: 33px;">
                                                        <span class="input-group-text mr-2" id="basic-addon6">
                                                            <img src="@Url.Content("~/theme2/assets/images/350.png")" class="datepicker-control-img" style="height:20px;">
                                                        </span>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessageFor(x => x.WorkItem.WorkDate)
                                            </div>
                                        </div>
                                        <div class="col-12" style="margin-top:-8px;">
                                            <div class="form-group">
                                                <label>Scheduled Rate Category</label>
                                                @Html.DropDownListFor(x => x.WorkItem.ScheduleRateID,
                                       new SelectList((List<SelectListItem>)ViewData["ScheduleRateCategories"], "Value", "Text"),
                                      "---Select---", new RouteValueDictionary(new { @class = "custom-select", @id = "ScheduleRateCategories" }))

                                            </div>
                                        </div>
                                        <div class="col-12" style="margin-top:-8px;">
                                            <div class="form-group">
                                                <label>Schedule Number</label>
                                                <select class="custom-select" style="background-color: white;" id="schNumberList">
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group">
                                                <label>Description</label>
                                                @Html.TextAreaFor(x => x.WorkItem.SRLIDescription, new { @class = "form-control form-control-sm", rows = "3", id = "schDesc", height = "20px", maxlength=250 })

                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6">
                                        <div class="col-12">
                                            <div class="form-group">
                                                <label>Rate</label>
                                                @Html.TextBoxFor(x => x.WorkItem.Rate, new RouteValueDictionary(new { @class = "form-control form-control-sm", id = "schRate" }))
                                                <span id="spnRateError" class="field-validation-error"></span>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-4">
                                                <div class="form-group" style="margin-left:16px">
                                                    <label>Unit</label>
                                                    @Html.TextBoxFor(x => x.WorkItem.Unit, new RouteValueDictionary(new { @class = "form-control form-control-sm", @id = "schUnit", @readonly = "readonly" }))

                                                </div>


                                            </div>
                                            <div class="col-7">
                                                <div class="form-group">
                                                    <label>Quantity</label>
                                                    @Html.TextBoxFor(x => x.WorkItem.Quantity, new RouteValueDictionary(new { @class = "form-control form-control-sm", id = "schQuantity" }))
                                                    <span id="spnQunError" class="field-validation-error"></span>

                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group">
                                                <label>Cost Adjustment</label>
                                                @Html.TextBoxFor(x => x.WorkItem.CostAdjPercent, new RouteValueDictionary(new { @class = "form-control form-control-sm", id = "costAdj", disabled = "disabled" }))
                                                <span id="spnCostAdjError" class="field-validation-error"></span>

                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group">
                                                <label>Adjusted Amount</label>
                                                @Html.TextBoxFor(x => x.WorkItem.Amount, new RouteValueDictionary(new { @class = "form-control form-control-sm", id = "txtAdjAmount" }))
                                                <span id="spnAdjAmountError" class="field-validation-error"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" >
                <button class="btn btn-info waves-effect waves-light" id="btnAddScheduleRate" type="button"><span class="btn-label"><i class="fa fa-save"></i></span>Save </button>
                <button type="button" class="btn btn-default waves-effect waves-light" data-dismiss="modal"><span class="btn-label"><i class="fa fa-eraser"></i></span>Close</button>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hdnScheduleRateId" />
@Html.HiddenFor(x => x.ServiceReportNewLineItems, new { id = "ServiceReportNewLineItems" })

@Html.HiddenFor(x => x.DeletedWorkItems, new { id = "DeletedWorkItems" })
@Html.HiddenFor(x => x.ApprovedWorkItems, new { id = "ApprovedWorkItems" })
@Html.HiddenFor(x => x.RejectedWorkItems, new { id = "RejectedWorkItems" })


<style type="text/css">
    .modal-footer {
        margin-top: -24px !important;
    }
    @@media (min-width: 348px) and (max-width: 720px) {
        .modal-content {
            clear:both !important;
            height: 100% !important;
        }
        .modal-footer
        {
            margin-top:0px !important;
        }
    }
    .text-centre {
        text-align: center;
    }
</style>